# Copy to .env.local (git-ignored) and fill in. Never commit real values.
# All services below have free plans. Do not add a card anywhere.

# Supabase (Project Settings > API). Server-only: these never reach the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Only these emails can sign in to your deployment (comma-separated).
ALLOWED_EMAILS=

# Public URL of your deployment, used to check the Origin header on writes.
APP_ORIGIN=

# Cloudflare Workers AI (main AI provider; does not train on or keep your data).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=

# Groq (fast fallback; turn on Zero Data Retention in Groq's Data Controls).
GROQ_API_KEY=

# Optional and off by default. Gemini's free tier may use inputs to improve Google
# products, so the app only ever sends it a photo plus a generic question, and only
# when AI_PHOTO_PROVIDER=gemini.
GEMINI_API_KEY=
AI_PHOTO_PROVIDER=cloudflare
